# PostgreSQL
POSTGRES_USER=finance_user
POSTGRES_PASSWORD=change_me_strong_password
POSTGRES_DB=finance_tracker
DATABASE_URL=postgresql+asyncpg://finance_user:change_me_strong_password@postgres:5432/finance_tracker

# Redis & Celery
REDIS_URL=redis://redis:6379/0
CACHE_TTL_SECONDS=60
ENABLE_REDIS_CACHE=true

# Security / Auth
SECRET_KEY=change_me_to_a_64_char_hex_secret_key_for_jwt_signing_0123456789
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
SESSION_TTL_SECONDS=86400
COOKIE_SECURE=false

# App & CORS
APP_ENV=development
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:5173
NGINX_DOMAIN=localhost

# Optional SMTP (for Celery Beat monthly email summaries)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=noreply@financetrace.local
